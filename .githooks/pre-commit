#!/bin/sh
set -e
staged=$(mktemp)
trap 'rm -f "$staged"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z >"$staged"
if [ -s "$staged" ]; then
  xargs -0 -a "$staged" mise exec -- bunx oxfmt --check --no-error-on-unmatched-pattern
  xargs -0 -a "$staged" mise exec -- bunx oxlint --no-error-on-unmatched-pattern
  xargs -0 -a "$staged" mise exec -- ast-grep scan
fi
mise exec -- bun check -b
exec mise exec -- bun test --parallel --changed
