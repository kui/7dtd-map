// Required Zed extensions: "oxc" (oxlint + oxfmt), "tsgo" (TypeScript 7
// language server) and "ast-grep". Without them Zed does not format or lint
// on save. All of them run the binaries installed by `npm ci`.
{
  "lsp": {
    // The tsgo extension downloads its own `typescript` package by default.
    // Run the project's TypeScript 7 instead, so diagnostics match `tsc -b`.
    // `bin/tsc` is a Node script that execs the platform-native binary.
    "typescript-ls": {
      "binary": {
        "path": "node",
        "arguments": ["node_modules/typescript/bin/tsc", "--lsp", "--stdio"]
      }
    },
    // The ast-grep extension only looks for `ast-grep` on PATH. A path with a
    // directory resolves against the worktree root, and Windows appends
    // `.exe` to it, so this works on every platform.
    "ast-grep": {
      "binary": {
        "path": "node_modules/@ast-grep/cli/ast-grep",
        "arguments": ["lsp"]
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "typescript-ls",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!deno",
        "..."
      ],
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "oxlint",
        "ast-grep",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!deno",
        "..."
      ],
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "CSS": {
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "JSON": {
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "JSONC": {
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "Markdown": {
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "TOML": {
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "YAML": {
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    // oxfmt ignores public/*.html on purpose. Keep Zed's default HTML
    // formatter from rewriting it on save.
    "HTML": {
      "format_on_save": "off"
    }
  }
}
